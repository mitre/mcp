# conf/local.yml -- optional operator overrides.
#
# Copy to conf/local.yml. It is gitignored; conf/default.yml is not.
#
# THIS FILE IS A SPARSE OVERLAY, NOT A FULL CONFIG. It is deep-merged over
# conf/default.yml key by key, so it needs only the keys you are changing.
# Everything you leave out keeps its shipped default. A file containing just
# a temperature is valid and complete.
#
# Two things that surprise people:
#
#   1. `cti` LAYERS OVER `llm`. Any key you set under cti wins for extraction.
#      Pinning `model` or `api_base` under cti means extraction ignores the llm
#      profile, which is usually not what you want.
#
#   2. The GUI's "Global Model Config" panel is BROWSER-LOCAL. It is stored in
#      localStorage and sent only with chat and planning requests. It does not
#      configure the CTI pipeline. Extraction reads this file, server-side.
#
# A key with no value parses as null and OVERRIDES the shipped default rather
# than falling through to it. Write `llm: {}` or omit the block entirely; do
# not leave a bare `llm:` heading.


# ----------------------------------------------------------------------
# One endpoint for everything. This is the common case.
# ----------------------------------------------------------------------
llm:
  model: Qwen/Qwen3-0.6B-Base
  api_base: https://api.featherless.ai/v1
  # false means "call the model". true skips the LLM entirely and extracts
  # with spaCy and the MITRE taxonomy.
  offline: false
  # Set to false only for a gateway with a self-signed certificate.
  ssl_verify: true

# Extraction inherits everything above. Only what it genuinely needs
# differently belongs here. Setting `model` or `api_base` in this block pins
# extraction to them and the panel will show it as "pinned".
cti:
  # Deterministic output: extraction emits JSON that Stage 1 parses.
  temperature: 0.0
  max_tokens: 4000
  timeout: 120
  offline: false


# ----------------------------------------------------------------------
# Credentials do not go here. This file is plaintext beside tracked config.
#
#   MCP_LLM_API_KEY   in plugins/mcp/.env, or per session through the UI
#   MCP_LLM_API_BASE  overrides api_base above when api_base is left empty
#
# api_key resolves env-first and is never read from this file.
# api_base resolves yaml-first, so a value here beats the env var.
# ----------------------------------------------------------------------


# ----------------------------------------------------------------------
# Separate model for extraction, if you want one. Uncomment to pin it.
# ----------------------------------------------------------------------
# cti:
#   model: some-other-model
#   api_base: https://another-gateway/v1
#   temperature: 0.0


# ----------------------------------------------------------------------
# MLflow. Override the port when two Caldera trees share a host, otherwise
# both bind 5000 and cross-contaminate each other's runs.
# ----------------------------------------------------------------------
# mlflow:
#   host: 127.0.0.1
#   port: 5050
