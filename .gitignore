# Artifacts and Metadata
**/__pycache__/
# MLflow's artifact root, created next to hook.py when it starts the server.
# The paired mlruns.db is covered by the *.db rule below.
mlruns/

# Environment
.env
.env.local
conf/local.yml

# Python/test caches
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Claude Code local settings
.claude/
CLAUDE.md

# Per-deployment runtime state
data/sessions.json

# CTI pipeline runtime/generated data
data/clean/
data/raw/
data/outputs_ir/
data/outputs_stix/
data/outputs_topology/
data/outputs_cad/
data/stix_bundle.json

# Operator-side backup files left by interactive edits
*.bak
*.bak_*

# Runtime databases
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Vendored external CTI / AE-library data — pull on demand, not tracked
app/utilities/data/external/

# Runtime cache for software-extraction OSV/NVD lookups (offline-safe)
app/utilities/data/cache/
